# Production vhost, as it runs on the host. The API itself is not published:
# k3s exposes it on NodePort 30983, reachable only from the machine, and nginx
# is the single public door.
#
# Install: copy to /etc/nginx/sites-available/, symlink into sites-enabled/,
# then `nginx -t && systemctl reload nginx`. TLS lines are managed by Certbot.

server {
    server_name conversion-pulse.brandaodeveloper.com.br;

    # Metrics carry request counts, latencies, heap usage and the full route
    # table. That is reconnaissance material — Prometheus scrapes it from
    # inside the cluster and nobody needs it from the internet.
    location = /metrics { deny all; return 404; }
    location /metrics/ { deny all; return 404; }

    location / {
        proxy_pass http://127.0.0.1:30983;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        client_max_body_size 10m;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/conversion-pulse.brandaodeveloper.com.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/conversion-pulse.brandaodeveloper.com.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = conversion-pulse.brandaodeveloper.com.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name conversion-pulse.brandaodeveloper.com.br;
    listen 80;
    listen [::]:80;
    return 404; # managed by Certbot
}
